{
  "name": "Books",
  "type": "object",
  "properties": {
    "product_identifier": {
      "type": "string",
      "description": "Identifiant unique de d\u00e9duplication: ISBN-13 valide ou EAN/merchant pr\u00e9fix\u00e9"
    },
    "identifier_type": {
      "type": "string",
      "enum": [
        "isbn13",
        "ean",
        "merchant_id"
      ],
      "default": "isbn13"
    },
    "isbn_valid": {
      "type": "boolean",
      "default": false
    },
    "product_type": {
      "type": "string",
      "enum": [
        "livre",
        "produit_editorial"
      ],
      "default": "livre"
    },
    "source_feed_id": {
      "type": "string",
      "description": "Flux Awin d'origine utilis\u00e9 lors du dernier import"
    },
    "source_feed_name": {
      "type": "string"
    },
    "isbn13": {
      "type": "string",
      "description": "ISBN-13 uniquement quand il est valide; vide pour un EAN non-ISBN"
    },
    "ean": {
      "type": "string",
      "description": "EAN source du flux marchand"
    },
    "title": {
      "type": "string"
    },
    "title_norm": {
      "type": "string",
      "description": "Titre normalis\u00e9 minuscules sans accents et ponctuation remplac\u00e9e par des espaces"
    },
    "title_tokens": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Mots normalis\u00e9s du titre, sans mots vides, pour recherche par contenu"
    },
    "author": {
      "type": "string"
    },
    "author_norm": {
      "type": "string",
      "description": "Auteur normalis\u00e9 minuscules sans accents"
    },
    "author_source": {
      "type": "string",
      "enum": [
        "feed",
        "openlibrary",
        "none"
      ],
      "default": "none"
    },
    "author_enriched_at": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "category_source": {
      "type": "string",
      "enum": [
        "feed_field",
        "feed_rayon"
      ]
    },
    "category_norm": {
      "type": "string",
      "description": "Cat\u00e9gorie normalis\u00e9e pour suggestions same_author puis same_category"
    },
    "language": {
      "type": "string"
    },
    "publisher": {
      "type": "string"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "admin_secondaire"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
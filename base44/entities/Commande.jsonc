{
  "name": "Commande",
  "type": "object",
  "properties": {
    "lecteur_email": {
      "type": "string",
      "description": "Email du lecteur"
    },
    "livre_titre": {
      "type": "string",
      "description": "Titre du livre command\u00e9"
    },
    "livre_auteur": {
      "type": "string"
    },
    "livre_type": {
      "type": "string",
      "enum": [
        "Poche",
        "Broch\u00e9",
        "BD",
        "Reli\u00e9"
      ],
      "default": "Poche"
    },
    "zone_id": {
      "type": "string",
      "enum": [
        "europe",
        "international",
        "grand_export",
        "maghreb"
      ]
    },
    "zone_nom": {
      "type": "string"
    },
    "point_relais_id": {
      "type": "string"
    },
    "mode_livraison": {
      "type": "string",
      "enum": [
        "express",
        "collectif"
      ],
      "default": "express"
    },
    "montant_paye": {
      "type": "number"
    },
    "stripe_session_id": {
      "type": "string"
    },
    "suivi_facturation_mode": {
      "type": "string",
      "enum": [
        "email",
        "application"
      ],
      "default": "application",
      "description": "Choix utilisateur pour recevoir le suivi et la facture"
    },
    "suivi_active": {
      "type": "boolean",
      "default": true,
      "description": "Indique si le suivi de commande est activ\u00e9"
    },
    "facture_reference": {
      "type": "string",
      "description": "R\u00e9f\u00e9rence de facture affich\u00e9e au lecteur"
    },
    "facture_emise_le": {
      "type": "string",
      "description": "Date ISO de g\u00e9n\u00e9ration de la facture"
    },
    "facture_url": {
      "type": "string",
      "description": "URL de facture si une facture externe est g\u00e9n\u00e9r\u00e9e"
    },
    "statut": {
      "type": "string",
      "enum": [
        "en_attente_paiement",
        "payee",
        "en_transit",
        "au_relais",
        "livree",
        "litige"
      ],
      "default": "en_attente_paiement"
    },
    "voyageur_email": {
      "type": "string"
    },
    "mission_id": {
      "type": "string"
    },
    "ticket_url": {
      "type": "string"
    },
    "qr_code_depot": {
      "type": "string"
    },
    "date_limite_collecte": {
      "type": "string",
      "description": "Date limite sans p\u00e9nalit\u00e9 (J+7 apr\u00e8s arriv\u00e9e relais)"
    },
    "date_arrivee_relais": {
      "type": "string",
      "description": "Date ISO de flashage \u00e0 l'arriv\u00e9e au relais \u2014 d\u00e9clenche le compte \u00e0 rebours"
    },
    "penalite_retard": {
      "type": "number",
      "default": 0,
      "description": "P\u00e9nalit\u00e9 cumul\u00e9e en \u20ac (0,50\u20ac/jour apr\u00e8s 7j) revers\u00e9e au relais"
    },
    "jours_retard": {
      "type": "number",
      "default": 0,
      "description": "Nombre de jours de retard au-del\u00e0 du d\u00e9lai de gr\u00e2ce de 7 jours"
    },
    "notes": {
      "type": "string"
    },
    "code_barre_isbn": {
      "type": "string"
    },
    "ticket_caisse_url": {
      "type": "string"
    },
    "scan_valide_par_voyageur": {
      "type": "boolean",
      "default": false
    },
    "validation_admin": {
      "type": "string",
      "enum": [
        "en_attente",
        "validee",
        "rejetee"
      ],
      "default": "en_attente"
    },
    "admin_notes": {
      "type": "string"
    },
    "notification_lecteur_envoyee": {
      "type": "boolean",
      "default": false
    },
    "prix_livre_neuf": {
      "type": "number"
    },
    "frais_port_ref": {
      "type": "number"
    },
    "frais_bordereau": {
      "type": "number"
    },
    "economie_realisee": {
      "type": "number"
    },
    "code_secret": {
      "type": "string",
      "description": "Code secret 3 chiffres pour valider la remise physique"
    },
    "part_voyageur": {
      "type": "number"
    },
    "part_relais": {
      "type": "number"
    },
    "part_admin": {
      "type": "number"
    }
  },
  "required": [
    "lecteur_email",
    "livre_titre",
    "zone_nom",
    "mode_livraison"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.lecteur_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.lecteur_email": "{{user.email}}"
        },
        {
          "data.voyageur_email": "{{user.email}}"
        },
        {
          "$and": [
            {
              "data.point_relais_id": "{{user.data.point_relais_id}}"
            },
            {
              "data.point_relais_id": {
                "$exists": true
              }
            },
            {
              "data.point_relais_id": {
                "$ne": ""
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "admin_secondaire"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.voyageur_email": "{{user.email}}"
        },
        {
          "$and": [
            {
              "data.point_relais_id": "{{user.data.point_relais_id}}"
            },
            {
              "data.point_relais_id": {
                "$ne": ""
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "data.statut": "en_attente_paiement"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
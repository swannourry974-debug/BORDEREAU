{
  "name": "ImportLog",
  "type": "object",
  "properties": {
    "started_at": {
      "type": "string"
    },
    "finished_at": {
      "type": "string"
    },
    "products_processed": {
      "type": "number",
      "default": 0
    },
    "books_created": {
      "type": "number",
      "default": 0
    },
    "offers_updated": {
      "type": "number",
      "default": 0
    },
    "duplicates": {
      "type": "number",
      "default": 0
    },
    "errors": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "running",
        "success",
        "failed",
        "partial"
      ],
      "default": "running"
    },
    "error_message": {
      "type": "string"
    },
    "source_retailer": {
      "type": "string"
    },
    "feed_size_bytes": {
      "type": "number"
    },
    "line_checkpoint": {
      "type": "number",
      "default": 0
    },
    "resume_from_line": {
      "type": "number",
      "default": 0
    },
    "test_limit": {
      "type": "number"
    },
    "control_report": {
      "type": "object",
      "description": "Rapport de contr\u00f4le du test import : doublons, offres, suggestions"
    }
  },
  "required": [
    "started_at",
    "source_retailer",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "admin_secondaire"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
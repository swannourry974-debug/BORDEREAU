{
  "name": "ImportRejection",
  "type": "object",
  "properties": {
    "ean_raw": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "reason": {
      "type": "string",
      "enum": [
        "non_book",
        "ean_not_isbn",
        "invalid_isbn",
        "invalid_price",
        "missing_title"
      ]
    },
    "feed_id": {
      "type": "string"
    },
    "product_identifier": {
      "type": "string"
    },
    "identifier_type": {
      "type": "string",
      "enum": [
        "isbn13",
        "ean",
        "merchant_id"
      ]
    },
    "isbn_valid": {
      "type": "boolean"
    },
    "product_type": {
      "type": "string",
      "enum": [
        "livre",
        "produit_editorial"
      ]
    },
    "classification": {
      "type": "string",
      "enum": [
        "livre",
        "revue",
        "produit_editorial",
        "non_eligible"
      ]
    },
    "classification_previous": {
      "type": "string",
      "description": "Ancienne valeur de product_type avant reclassement"
    },
    "classification_updated_at": {
      "type": "string"
    },
    "classification_source": {
      "type": "string"
    },
    "import_date": {
      "type": "string"
    },
    "reviewed": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "reason",
    "feed_id",
    "import_date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "admin_secondaire"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
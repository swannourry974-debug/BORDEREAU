{
  "name": "ImportRun",
  "type": "object",
  "properties": {
    "feed_id": {
      "type": "string",
      "description": "Identifiant du flux Cultura autoris\u00e9"
    },
    "feed_name": {
      "type": "string"
    },
    "feed_order": {
      "type": "number",
      "description": "Ordre strict de traitement de 1 \u00e0 5"
    },
    "checkpoint_line": {
      "type": "number",
      "default": 0,
      "description": "Derni\u00e8re ligne CSV trait\u00e9e pour reprise durable"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "paused",
        "completed",
        "failed"
      ],
      "default": "pending"
    },
    "stop_requested": {
      "type": "boolean",
      "default": false,
      "description": "Arr\u00eat volontaire explicite demand\u00e9 par Swanny; seul motif autoris\u00e9 pour ne pas relancer automatiquement"
    },
    "stop_requested_at": {
      "type": "string"
    },
    "stop_requested_reason": {
      "type": "string"
    },
    "auto_recovery_attempts": {
      "type": "number",
      "default": 0,
      "description": "Nombre de tentatives de relance automatique depuis le dernier lot r\u00e9ussi"
    },
    "next_retry_at": {
      "type": "string",
      "description": "Date ISO de prochaine tentative automatique apr\u00e8s \u00e9chec technique"
    },
    "last_auto_recovery_at": {
      "type": "string"
    },
    "last_blockage_detected_at": {
      "type": "string"
    },
    "last_automation_beat": {
      "type": "string",
      "description": "Dernier d\u00e9clenchement constat\u00e9 de l'automatisation planifi\u00e9e"
    },
    "last_automation_beat_result": {
      "type": "object",
      "description": "R\u00e9sultat du dernier d\u00e9clenchement: statut, dur\u00e9e, erreur, lots trait\u00e9s"
    },
    "last_global_check_at": {
      "type": "string",
      "description": "Dernier contr\u00f4le global complet volontaire ou horaire"
    },
    "lines_processed": {
      "type": "number",
      "default": 0
    },
    "books_created": {
      "type": "number",
      "default": 0
    },
    "books_updated": {
      "type": "number",
      "default": 0
    },
    "offers_created": {
      "type": "number",
      "default": 0
    },
    "offers_updated": {
      "type": "number",
      "default": 0
    },
    "rows_rejected": {
      "type": "number",
      "default": 0
    },
    "errors": {
      "type": "number",
      "default": 0
    },
    "checks_json": {
      "type": "object",
      "description": "Dernier rapport de contr\u00f4les automatiques"
    },
    "paused_reason": {
      "type": "string"
    },
    "started_at": {
      "type": "string"
    },
    "last_batch_at": {
      "type": "string"
    },
    "finished_at": {
      "type": "string"
    }
  },
  "required": [
    "feed_id",
    "feed_name",
    "feed_order",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "admin_secondaire"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
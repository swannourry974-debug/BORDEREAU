{
  "name": "MissionVoyageur",
  "type": "object",
  "properties": {
    "voyageur_email": {
      "type": "string",
      "description": "Email du voyageur"
    },
    "commande_id": {
      "type": "string",
      "description": "ID de la commande associ\u00e9e"
    },
    "mode_livraison": {
      "type": "string",
      "enum": [
        "express",
        "collectif"
      ],
      "default": "express",
      "description": "Les voyageurs ne voient et n'acceptent que les missions express"
    },
    "livre": {
      "type": "string",
      "description": "Titre du livre"
    },
    "auteur": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "Poche",
        "Broch\u00e9",
        "BD",
        "Reli\u00e9"
      ],
      "default": "Poche"
    },
    "poids": {
      "type": "string"
    },
    "ville_destination": {
      "type": "string"
    },
    "date_limite": {
      "type": "string"
    },
    "statut": {
      "type": "string",
      "enum": [
        "disponible",
        "acceptee",
        "engagee",
        "livree"
      ],
      "default": "disponible"
    },
    "numero_ordre": {
      "type": "number",
      "description": "Position dans la valise du voyageur (1-10)"
    },
    "commission": {
      "type": "number",
      "description": "Montant de la commission pour ce livre"
    },
    "ticket_url": {
      "type": "string",
      "description": "URL du ticket de caisse scann\u00e9"
    }
  },
  "required": [
    "livre",
    "ville_destination"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "$and": [
            {
              "data.voyageur_email": "{{user.email}}"
            },
            {
              "data.mode_livraison": "express"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.statut": "disponible"
            },
            {
              "data.mode_livraison": "express"
            }
          ]
        },
        {
          "$and": [
            {
              "data.voyageur_email": "{{user.email}}"
            },
            {
              "data.mode_livraison": "express"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "admin_secondaire"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "data.statut": "disponible"
            },
            {
              "data.mode_livraison": "express"
            }
          ]
        },
        {
          "$and": [
            {
              "data.voyageur_email": "{{user.email}}"
            },
            {
              "data.mode_livraison": "express"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "data.voyageur_email": "{{user.email}}"
            },
            {
              "data.mode_livraison": "express"
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
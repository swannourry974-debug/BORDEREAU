{
  "name": "MissionVoyageur",
  "type": "object",
  "properties": {
    "voyageur_email": {
      "type": "string",
      "description": "Email du voyageur"
    },
    "commande_id": {
      "type": "string",
      "description": "ID de la commande associ\u00e9e"
    },
    "commande_livre_ref": {
      "type": "string",
      "description": "Cl\u00e9 idempotente commande + livre pour emp\u00eacher les doublons"
    },
    "mode_livraison": {
      "type": "string",
      "enum": [
        "express",
        "collectif"
      ],
      "default": "express",
      "description": "Les voyageurs ne voient et n'acceptent que les missions express"
    },
    "livre": {
      "type": "string",
      "description": "Titre du livre"
    },
    "auteur": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "Poche",
        "Broch\u00e9",
        "BD",
        "Reli\u00e9"
      ],
      "default": "Poche"
    },
    "poids": {
      "type": "string"
    },
    "ville_destination": {
      "type": "string"
    },
    "zone_id": {
      "type": "string"
    },
    "point_relais_id": {
      "type": "string"
    },
    "point_relais_nom": {
      "type": "string"
    },
    "depart_ville": {
      "type": "string"
    },
    "trajet_label": {
      "type": "string"
    },
    "date_limite": {
      "type": "string"
    },
    "annonce_expire_at": {
      "type": "string",
      "description": "Date ISO d'expiration apr\u00e8s 7 jours sans prise en charge"
    },
    "expiree_at": {
      "type": "string"
    },
    "acceptee_at": {
      "type": "string"
    },
    "deposee_relais_at": {
      "type": "string"
    },
    "retiree_at": {
      "type": "string"
    },
    "annulee_at": {
      "type": "string"
    },
    "annulation_source": {
      "type": "string"
    },
    "annonce_anonyme": {
      "type": "boolean",
      "default": true
    },
    "annonce_source": {
      "type": "string"
    },
    "statut": {
      "type": "string",
      "enum": [
        "disponible",
        "acceptee",
        "engagee",
        "en_transit",
        "deposee_relais",
        "livree",
        "retiree",
        "expiree",
        "annulee"
      ],
      "default": "disponible"
    },
    "numero_ordre": {
      "type": "number",
      "description": "Position dans la valise du voyageur (1-10)"
    },
    "commission": {
      "type": "number",
      "description": "Montant de la commission pour ce livre"
    },
    "ticket_url": {
      "type": "string",
      "description": "URL du ticket de caisse scann\u00e9"
    },
    "justificatif_photo_uri": {
      "type": "string",
      "description": "Fichier priv\u00e9 du justificatif photo associ\u00e9 \u00e0 la mission"
    },
    "justificatif_photo_nom": {
      "type": "string",
      "description": "Nom du fichier justificatif photo"
    },
    "justificatif_photo_date": {
      "type": "string",
      "description": "Date ISO d'envoi du justificatif photo"
    }
  },
  "required": [
    "livre",
    "ville_destination"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "admin_secondaire"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.voyageur_email": "{{user.email}}"
        },
        {
          "$and": [
            {
              "data.mode_livraison": "express"
            },
            {
              "data.statut": {
                "$in": [
                  "disponible",
                  "expiree"
                ]
              }
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "voyageur"
                  }
                },
                {
                  "user_condition": {
                    "role": "admin"
                  }
                },
                {
                  "user_condition": {
                    "role": "admin_secondaire"
                  }
                }
              ]
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "admin_secondaire"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.voyageur_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "admin_secondaire"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "admin_secondaire"
          }
        }
      ]
    }
  }
}
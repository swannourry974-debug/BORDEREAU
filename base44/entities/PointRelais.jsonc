{
  "name": "PointRelais",
  "type": "object",
  "properties": {
    "nom": {
      "type": "string",
      "description": "Nom du commerce partenaire"
    },
    "identifiant_connexion": {
      "type": "string",
      "description": "Identifiant relais souhait\u00e9 pour rep\u00e9rer le compte commerce"
    },
    "adresse": {
      "type": "string"
    },
    "ville": {
      "type": "string"
    },
    "pays_code": {
      "type": "string",
      "description": "Code ISO pays"
    },
    "pays_nom": {
      "type": "string",
      "description": "Pays du commerce partenaire"
    },
    "type_commerce": {
      "type": "string",
      "enum": [
        "Boulangerie",
        "Caf\u00e9",
        "Restaurant"
      ],
      "description": "Type de commerce candidat Point Relais"
    },
    "zone_id": {
      "type": "string",
      "description": "R\u00e9f\u00e9rence vers ZonesTarifs"
    },
    "gerant_email": {
      "type": "string",
      "description": "Email du g\u00e9rant (compte relais)"
    },
    "validation_admin": {
      "type": "string",
      "enum": [
        "en_attente",
        "valide",
        "rejete"
      ],
      "default": "en_attente",
      "description": "Validation administrateur obligatoire avant acc\u00e8s relais"
    },
    "telephone": {
      "type": "string"
    },
    "horaires": {
      "type": "string",
      "description": "Ex: Lun-Sam 9h-19h"
    },
    "stock_actuel": {
      "type": "number",
      "default": 0,
      "description": "Nombre de colis actuellement en stock"
    },
    "actif": {
      "type": "boolean",
      "default": false
    },
    "note_moyenne": {
      "type": "number",
      "description": "Note de satisfaction (1-5)"
    }
  },
  "required": [
    "nom",
    "adresse",
    "ville",
    "pays_code",
    "type_commerce",
    "gerant_email",
    "telephone",
    "horaires"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.gerant_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.actif": true
            },
            {
              "data.validation_admin": "valide"
            }
          ]
        },
        {
          "data.gerant_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "admin_secondaire"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "data.gerant_email": "{{user.email}}"
            },
            {
              "data.validation_admin": {
                "$in": [
                  "en_attente",
                  "rejete"
                ]
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "VoyageurBadge",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email du voyageur"
    },
    "badge_id": {
      "type": "string",
      "description": "Identifiant unique du badge (ex: premier_livre, grand_lecteur)"
    },
    "badge_nom": {
      "type": "string",
      "description": "Nom affich\u00e9 du badge"
    },
    "badge_emoji": {
      "type": "string",
      "description": "Emoji repr\u00e9sentant le badge"
    },
    "debloque_le": {
      "type": "string",
      "description": "Date de d\u00e9verrouillage"
    }
  },
  "required": [
    "user_email",
    "badge_id",
    "badge_nom"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "Notifier suivi commande",
  "description": "Informe le lecteur quand le statut de sa commande change et active le suivi/facture selon son choix.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"statut\") != null) and (.trigger.data.suivi_active == true)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "Commande"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notifier_suivi_commande",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifierSuiviCommande",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "notifierSuiviCommande"
  }
}
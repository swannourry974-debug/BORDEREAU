{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "poursuite_import_catalogue_cultura",
      "version": "1.2",
      "namespace": "base44"
    },
    "do": [
      {
        "traiter_lot": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runCatalogImport",
            "args": {
              "action": "step",
              "batch_size": 2000,
              "auto_chain": true,
              "automation": true,
              "max_steps": 8
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Battement import",
            "description": "Lots sans scan global"
          }
        }
      }
    ]
  },
  "description": "Toutes les 5 minutes, d\u00e9clenche runCatalogImport avec heartbeat, rattrapage born\u00e9 et contr\u00f4le incr\u00e9mental uniquement. Le contr\u00f4le global complet reste r\u00e9serv\u00e9 \u00e0 l\u2019action checks.",
  "name": "Poursuite import catalogue Cultura"
}
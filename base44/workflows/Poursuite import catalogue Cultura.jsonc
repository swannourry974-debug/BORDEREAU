{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "poursuite_import_catalogue_cultura",
      "version": "1.1",
      "namespace": "base44"
    },
    "do": [
      {
        "traiter_lot": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runCatalogImport",
            "args": {
              "action": "step",
              "batch_size": 2000,
              "auto_chain": true,
              "max_steps": 3
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Relancer l\u2019import",
            "description": "2 000 lignes, auto-reprise"
          }
        }
      }
    ]
  },
  "description": "Toutes les 5 minutes, lance runCatalogImport en mode reprise automatique. Le planificateur Base44 n\u2019autorise pas moins de 5 minutes; la fonction encha\u00eene plusieurs lots si le dernier lot date de plus de 5 minutes.",
  "name": "Poursuite import catalogue Cultura"
}
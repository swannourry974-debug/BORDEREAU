{
  "name": "Synchronisation catalogue Cultura quotidienne",
  "description": "Synchronise chaque jour \u00e0 03:00 Europe/Paris les flux livres Cultura FR, flux apr\u00e8s flux, avec reprise par checkpoint et sans suppression du catalogue existant.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 3 * * *",
      "one_time_date": null,
      "timezone": "Europe/Paris",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "sync_catalogue_cultura_daily",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "import_catalogue": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "importAwinCultura",
            "args": {
              "mode": "full",
              "resume": true
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Importer Cultura",
            "description": "Multi-flux livres"
          }
        }
      }
    ]
  }
}